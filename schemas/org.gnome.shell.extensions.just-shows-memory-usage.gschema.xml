<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.just-shows-memory-usage" path="/org/gnome/shell/extensions/just-shows-memory-usage/">
    <key name="timeout" type="u">
      <default>1000</default>
      <summary>Timeout</summary>
      <description>Timeout setting.</description>
    </key>
    <key name="digits" type="u">
      <default>2</default>
      <summary>Digits</summary>
      <description>Number of displayed decimal digits.</description>
    </key>
    <key name="display-mode" type="u">
      <default>0</default>
      <summary>Display Format</summary>
      <description>0: Used/Total, 1: Used/Total (%), 2: %, 3: Used (%)</description>
    </key>
    <key name="low-memory-alert" type="b">
      <default>false</default>
      <summary>Low memory alert</summary>
      <description>Change the widget background when free memory is below the threshold.</description>
    </key>
    <key name="low-memory-threshold" type="u">
      <range min="1" max="99"/>
      <default>10</default>
      <summary>Low memory threshold</summary>
      <description>Percentage of free memory below which the widget background is changed.</description>
    </key>
    <key name="low-memory-color" type="s">
      <default>'#8b0000'</default>
      <summary>Low memory background color</summary>
      <description>Widget background color used when free memory is low.</description>
    </key>
    <key name="low-memory-dark-text" type="b">
      <default>false</default>
      <summary>Dark text on low memory</summary>
      <description>Use black text instead of white when free memory is low (for light background colors).</description>
    </key>
  </schema>
</schemalist>